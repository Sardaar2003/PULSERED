# PulseRed AI Suite - Environment Variables Template
PORT=5000
NODE_ENV=development

# Database & Auth
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/pulsered
JWT_SECRET=your_jwt_secret_key_here

PROWLO_API_KEY=your_prowlo_api_key_here
REDDITAPIS_API_KEY=your_redditapis_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENAI_API_KEY=your_openai_api_key_here

